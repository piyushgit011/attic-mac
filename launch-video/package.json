{
  "name": "attic-launch-video",
  "version": "1.0.0",
  "private": true,
  "description": "Attic launch video for X (Remotion, 16:9). Music from ElevenLabs.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts AtticLaunch out/attic-launch.mp4 --codec h264 --crf 18",
    "still": "remotion still src/index.ts AtticLaunch out/still.png --frame 200",
    "audio": "node --env-file=../../versely/content-creation-backend/.env scripts/generate-audio.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/media": "4.0.529",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
